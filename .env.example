# CrewCast Lagos Environment Configuration
# Copy this file to .env for local development

# Security & Debug
SECRET_KEY=insecure-development-key-change-in-production-lagos-weather-planning
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL in production and CI; falls back to sqlite for offline local development if unconfigured)
DATABASE_URL=postgresql://crewcast_user:crewcast_pass@localhost:5432/crewcast_db

# Cache & Celery Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Operational Policy & Rate Limits
DAILY_PROVIDER_BUDGET=300
PROVIDER_CIRCUIT_COOLOFF_SECONDS=900
PROVIDER_MAX_RETRIES=2

# Application Modes
DEMO_MODE=False
